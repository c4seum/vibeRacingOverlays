<Window x:Class="vibeRacingOverlays.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vibeRacingOverlays" Icon="app.ico" Height="900" Width="1040" MinWidth="760" MinHeight="480"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- top bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="12,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="AppTitle" Text="vibeRacingOverlays" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Data:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SourceBox" Width="110" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="-" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                <ToggleButton x:Name="OverlaysToggle" DockPanel.Dock="Right" Content="Toggle overlay" ToolTip="Show or hide all widgets (Ctrl+Shift+H)" Margin="0"/>
                <ToggleButton x:Name="EditToggle" DockPanel.Dock="Right" Content="Edit layout"/>
                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="90" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="App theme"/>
                <TextBlock DockPanel.Dock="Right" Text="Theme:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            </DockPanel>
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="12,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </Border>

        <!-- overlay list -->
        <Border DockPanel.Dock="Left" Width="240" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="LAYOUT" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,6"/>
                <ComboBox x:Name="LayoutBox" DockPanel.Dock="Top" DisplayMemberPath="Name" Margin="0,0,0,6" ToolTip="Active layout (next layout: Ctrl+Shift+L)"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button x:Name="LayoutNewButton" Content="New" Padding="8,3" Margin="0,0,4,4" ToolTip="New layout with one widget of each type"/>
                    <Button x:Name="LayoutSaveAsButton" Content="Save as" Padding="8,3" Margin="0,0,4,4" ToolTip="Save the current layout under a new name"/>
                    <Button x:Name="LayoutRenameButton" Content="Rename" Padding="8,3" Margin="0,0,4,4"/>
                    <Button x:Name="LayoutDeleteButton" Content="Delete" Padding="8,3" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="WIDGETS" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Content="+ Add" ToolTip="Add a widget: Standings, Relative or Fuel calculator"/>
                    <Button x:Name="DuplicateButton" Content="Duplicate"/>
                    <Button x:Name="RemoveButton" Content="Remove"/>
                </StackPanel>
                <ListBox x:Name="WidgetList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"/>
            </DockPanel>
        </Border>

        <!-- preview + settings + position; stacked (preview on top, position right of the settings)
             or side by side (settings left, preview and position right), see MainWindow.ApplyEditorLayout -->
        <Grid x:Name="EditorGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="PreviewHost"/>
            <GridSplitter x:Name="EditorSplitter" Width="5" HorizontalAlignment="Stretch" Visibility="Collapsed"
                          Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext"/>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel x:Name="SettingsHost" MaxWidth="620" HorizontalAlignment="Left"/>
            </ScrollViewer>
            <ScrollViewer x:Name="PositionScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="18,12">
                <ContentControl x:Name="PositionHost" Width="500" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
