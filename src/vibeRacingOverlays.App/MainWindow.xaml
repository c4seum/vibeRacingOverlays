<Window x:Class="vibeRacingOverlays.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vibeRacingOverlays" Icon="app.ico" Height="900" Width="1480"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" AllowDrop="True">
    <DockPanel>
        <!-- top bar: app name and data status on the left, the global actions on the right -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="16,8" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Image Source="/app.ico" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="AppTitle" Text="vibeRacingOverlays" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <!-- presets and files for the active layout and the selected widget (filled when opened) -->
                <Menu x:Name="MainMenu" VerticalAlignment="Center" Margin="0,0,14,0">
                    <MenuItem x:Name="LayoutMenu" Header="Layout"><MenuItem Header="..."/></MenuItem>
                    <MenuItem x:Name="WidgetMenu" Header="Widget"><MenuItem Header="..."/></MenuItem>
                </Menu>
                <!-- undo / redo of the active layout (MainWindow.Undo.cs) -->
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" IsEnabled="False" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" IsEnabled="False" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Border CornerRadius="12" Padding="10,4" Background="{DynamicResource Field}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusText" Text="-" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Data" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SourceBox" Width="110" VerticalAlignment="Center"/>

                <ToggleButton x:Name="OverlaysToggle" DockPanel.Dock="Right" Content="Toggle overlay" ToolTip="Show or hide all widgets (Ctrl+Shift+H)" Margin="0"/>
                <ToggleButton x:Name="EditToggle" DockPanel.Dock="Right" Content="Edit layout" ToolTip="Move, resize and lock widgets on screen (Ctrl+Shift+E)"/>
                <Border DockPanel.Dock="Right" Width="1" Height="20" Background="{DynamicResource Divider}" Margin="8,0,14,0" VerticalAlignment="Center"/>
                <!-- shown when the update check found a newer release -->
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="96" VerticalAlignment="Center" ToolTip="App theme"/>
                <TextBlock DockPanel.Dock="Right" Text="Theme" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="16,7" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- sidebar: layouts and the widgets of the active layout -->
        <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">
                <TextBlock DockPanel.Dock="Top" Text="LAYOUT" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,6"/>
                <ComboBox x:Name="LayoutBox" DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="The layout you're using (next layout: Ctrl+Shift+L). Every change is kept automatically. New layouts, presets and files: the Layout menu"/>
                <Border DockPanel.Dock="Top" Height="14"/>
                <TextBlock DockPanel.Dock="Top" Text="WIDGETS" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,6"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove the selected widget"/>
                    <Button x:Name="DuplicateButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicate the selected widget" Margin="4,0"/>
                    <Button x:Name="AddButton" ToolTip="Add a widget: Standings, Relative or Fuel calculator" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="Add widget" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <ListBox x:Name="WidgetList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- preview + settings + position; stacked (preview on top, position right of the settings)
             or side by side (settings left, preview and position right), see MainWindow.ApplyEditorLayout -->
        <Grid x:Name="EditorGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="PreviewHost"/>
            <GridSplitter x:Name="EditorSplitter" Width="4" HorizontalAlignment="Stretch" Visibility="Collapsed"
                          Background="{DynamicResource Divider}" ResizeBehavior="PreviousAndNext"/>
            <!-- fixed-width blocks, centred in their area (widths: MainWindow.SettingsWidth / PositionWidth) -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel x:Name="SettingsHost" Width="620" HorizontalAlignment="Center"/>
            </ScrollViewer>
            <ScrollViewer x:Name="PositionScroll" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <ContentControl x:Name="PositionHost" Width="480" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
